{
  "name": "gene-academy",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "npm --prefix appname run dev",
    "dev:api": "cd appname && ..\\.venv\\Scripts\\python.exe backend/app.py",
    "dev:editor": "npm --prefix auto-editor run dev",
    "setup": "npm install && npm --prefix appname install && npm --prefix auto-editor install",
    "build": "npm --prefix appname run build",
    "preview": "npm --prefix appname run preview",
    "lint": "npm --prefix appname run lint"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.20.0"
  }
}
